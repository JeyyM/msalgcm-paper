{
  "experiment_name": "jsp_ft10_comparison",
  "domain": "scheduling",
  "instance": "ft10",
  "instance_path": "datasets/scheduling/jsp/instances/ft10.txt",
  "algorithms": ["simulated_annealing", "tabu_search", "particle_swarm"],
  "runs": 10,
  "evaluation_budget": 50000,
  "seed_policy": {
    "base_seed": 2000
  },
  "domain_config": {
    "initial_solution": "longest_processing_time",
    "operators": ["swap", "insertion", "inversion"]
  },
  "algorithm_configs": {
    "simulated_annealing": {
      "initial_temperature": 8000.0,
      "final_temperature": 0.001,
      "cooling_factor": 0.999,
      "moves_per_temperature": 150
    },
    "tabu_search": {
      "tabu_tenure": 20,
      "candidate_list_size": 40
    },
    "particle_swarm": {
      "swarm_size": 40,
      "inertia_weight": 0.6,
      "cognitive_coefficient": 1.8,
      "social_coefficient": 1.8
    }
  },
  "output": {
    "directory": "results"
  }
}
