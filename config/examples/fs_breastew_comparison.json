{
  "experiment_name": "fs_breastew_comparison",
  "domain": "feature_selection",
  "instance": "BreastEW",
  "instance_path": "datasets/feature_selection/ew/BreastEW.csv",
  "algorithms": ["simulated_annealing", "tabu_search", "particle_swarm"],
  "runs": 30,
  "evaluation_budget": 5000,
  "seed_policy": {
    "base_seed": 4000
  },
  "domain_config": {
    "performance_weight": 0.9,
    "reduction_weight": 0.1,
    "test_size": 0.3,
    "cv_folds": 5,
    "k_neighbors": 5,
    "initial_solution": "random",
    "operators": ["flip", "swap"]
  },
  "algorithm_configs": {
    "simulated_annealing": {
      "initial_temperature": 1.0,
      "final_temperature": 0.001,
      "cooling_factor": 0.995,
      "moves_per_temperature": 50
    },
    "tabu_search": {
      "tabu_tenure": 15,
      "candidate_list_size": 30
    },
    "particle_swarm": {
      "swarm_size": 30,
      "inertia_weight": 0.7,
      "cognitive_coefficient": 1.5,
      "social_coefficient": 1.5
    }
  },
  "output": {
    "directory": "results"
  }
}
