{
  "experiment_name": "tsp_st70_smoke",
  "domain": "tsp",
  "instance": "st70",
  "instance_path": "datasets/tsp/instances/st70.tsp",
  "algorithms": ["simulated_annealing", "tabu_search"],
  "runs": 1,
  "evaluation_budget": 500,
  "seed_policy": { "base_seed": 42 },
  "domain_config": {
    "initial_solution": "nearest_neighbor",
    "operators": ["two_opt", "swap"]
  },
  "algorithm_configs": {
    "simulated_annealing": {
      "initial_temperature": 100.0,
      "final_temperature": 0.1,
      "cooling_factor": 0.95,
      "moves_per_temperature": 10
    },
    "tabu_search": {
      "tabu_tenure": 10,
      "candidate_list_size": 10
    }
  },
  "output": { "directory": "results" }
}
