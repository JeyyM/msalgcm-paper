{
  "experiment_name": "tsp_eil51_particle_swarm",
  "domain": "tsp",
  "instance": "eil51",
  "algorithms": [
    "particle_swarm"
  ],
  "runs": 30,
  "evaluation_budget": 100000,
  "seed_policy": {
    "base_seed": 1000
  },
  "instance_path": "datasets/tsp/instances/eil51.tsp",
