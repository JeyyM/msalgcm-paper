            xmlns:stRef="http://ns.adobe.com/xap/1.0/sType/ResourceRef#"
            xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/"
            xmlns:xmpTPg="http://ns.adobe.com/xap/1.0/t/pg/"
